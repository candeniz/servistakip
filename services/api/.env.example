# Backend'i tek başına (Docker olmadan) çalıştırırken kullanılabilecek örnek .env
# Not: docker compose kök dizindeki .env dosyasını kullanır.

DATABASE_URL=postgresql+asyncpg://servis:servis_dev_pw@localhost:5432/servis_takip
ALEMBIC_DATABASE_URL=postgresql+psycopg://servis:servis_dev_pw@localhost:5432/servis_takip
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-please-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

API_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ETA_PROVIDER=mock
SEED_DEMO_DATA=true
