# ============================================================
# Servis Takip - Ortam Değişkenleri (örnek)
# Kök dizinde .env olarak kopyalayın: cp .env.example .env
# ============================================================

# ---- PostgreSQL / PostGIS ----
POSTGRES_USER=servis
POSTGRES_PASSWORD=servis_dev_pw
POSTGRES_DB=servis_takip
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend'in kullandığı bağlantı (docker-compose içindeki host adı = db)
DATABASE_URL=postgresql+asyncpg://servis:servis_dev_pw@db:5432/servis_takip
ALEMBIC_DATABASE_URL=postgresql+psycopg://servis:servis_dev_pw@db:5432/servis_takip

# ---- Redis (WebSocket pub/sub) ----
REDIS_URL=redis://redis:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-me-in-production-please-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- API ----
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ETA sağlayıcısı: mock | google | mapbox
ETA_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Firebase Cloud Messaging — servis hesabı JSON yolu (gizli, repoya konmaz).
# Docker'da secrets/ klasörü konteyner içine /app/secrets olarak mount edilir.
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json

# Demo seed verisini yükle
SEED_DEMO_DATA=true
